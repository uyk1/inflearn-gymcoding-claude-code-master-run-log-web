# 사용법: 이 파일을 복사해 .env.local을 만든 뒤 값을 채웁니다.
# .env.local은 .gitignore에 의해 커밋되지 않습니다.

# 공개 환경 변수 (브라우저에서도 접근 가능, NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Run Log"

# 서버 전용 환경 변수 (API 키 등, 접두사 없이 작성)
# Notion 통합(integration) 키. 노션에서 발급받아 .env.local에만 저장합니다.
NOTION_API_KEY=
# 러닝 기록 data source ID (DB ID가 아님). 노션 DB를 연결한 뒤 확인합니다.
NOTION_DATA_SOURCE_ID=

# 테스트 전용: 목록(/runs)의 노션 조회 캐시 기간(초). 기본값은 60(1분)입니다.
# 노션에서 바꾼 내용을 빨리 확인할 때만 .env.local에 낮은 값(예: 10)으로 설정하고, 운영(배포)에는 설정하지 않습니다.
# 홈과 상세는 같은 조회 캐시를 읽으므로 이 값이 60보다 작으면 반영 주기(ISR)도 그 값으로 함께 짧아집니다.
# 값이 올바르지 않으면 경고 로그를 남기고 60을 씁니다.
# RUN_RECORDS_REVALIDATE_SECONDS=10

# 관리자 인증 (v2). 값은 .env.local과 배포 플랫폼 콘솔에만 입력하고 저장소에는 기록하지 않습니다.
# 관리자 로그인 비밀번호. 길고 추측하기 어려운 값을 씁니다.
ADMIN_PASSWORD=
# 세션 쿠키 서명용 비밀값. 32자 이상 무작위 문자열을 씁니다(예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# 이 값을 바꾸면 기존 로그인 세션이 모두 무효가 됩니다.
ADMIN_SESSION_SECRET=

# 관리자 쓰기용 노션 통합 키 (v2). 읽기·삽입·수정 권한이 있는 통합의 키이며 서버 전용입니다(접두사 없음).
# 공개 화면이 쓰는 NOTION_API_KEY(읽기 전용 권장)와 코드 경로가 분리되어 있고, 이 키는 lib/notion/admin에서만 읽습니다.
# 배포 플랫폼에는 Production에만 등록하고 Preview에는 등록하지 않습니다. 값에 $가 있으면 .env.local에서는 \$로 적습니다.
NOTION_ADMIN_API_KEY=
