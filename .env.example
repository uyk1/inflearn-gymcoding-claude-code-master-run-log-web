# 사용법: 이 파일을 복사해 .env.local을 만든 뒤 값을 채웁니다.
# .env.local은 .gitignore에 의해 커밋되지 않습니다.

# 공개 환경 변수 (브라우저에서도 접근 가능, NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Run Log"

# 서버 전용 환경 변수 (API 키 등, 접두사 없이 작성)
# Notion 통합(integration) 키. 노션에서 발급받아 .env.local에만 저장합니다.
NOTION_API_KEY=
# 러닝 기록 data source ID (DB ID가 아님). 노션 DB를 연결한 뒤 확인합니다.
NOTION_DATA_SOURCE_ID=

# 테스트 전용: 목록(/runs)의 노션 조회 캐시 기간(초). 기본값은 300(5분)입니다.
# 노션에서 바꾼 내용을 빨리 확인할 때만 .env.local에 낮은 값(예: 10)으로 설정하고, 운영(배포)에는 설정하지 않습니다.
# 홈과 상세 화면의 반영 주기(ISR 300초)는 그대로입니다. 값이 올바르지 않으면 경고 로그를 남기고 300을 씁니다.
# RUN_RECORDS_REVALIDATE_SECONDS=10
