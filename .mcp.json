{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2.0.0"
      ],
      "env": {}
    },
    "shadcn": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "env": {}
    },
    "mcpServers": {
      "shrimp-task-manager": {
        "command": "node",
        "args": ["D:\\ohk1\\학습\\클로드 코드 완벽 마스터\\workspace\\mcp-shrimp-task-manager/dist/index.js"],
        "env": {
          "DATA_DIR": "D:\\ohk1\\학습\\클로드 코드 완벽 마스터\\workspace\\claude-code-master-run-log-web\\shrimp_data",
          "TEMPLATES_USE": "en",
          "ENABLE_GUI": "false"
        }
      }
    }
  }
}